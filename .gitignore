# Репозиторийн үндсэн .gitignore — БҮХ хавтсад үйлчилнэ.
#
# goal-app/.gitignore нь зөвхөн goal-app дотор үйлчилдэг. Тэндхийн мөрүүд
# "/node_modules" гэж налуу зураасаар эхэлсэн бөгөөд энэ нь "өөрийн
# хавтаснаасаа эхлэн" гэсэн утгатай. Иймд репозиторийн үндэс дээр үүссэн
# ижил нэртэй хавтсыг тэр файл барихгүй.
#
# Бодит жишээ: үндэс дээр `npm install` ажиллуулахад node_modules бүхэлдээ
# git-д орж PR #39 дээр мянга мянган файл нэмэгдсэн.

# ── Хамаарал ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build-ийн үр дүн ──────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Орчны хувьсагч ────────────────────────────────────────────────────
# Эдгээр файлд ӨС-ийн нууц үг, API түлхүүр байдаг. Нэг удаа push хийвэл
# git-ийн түүхэнд үлдэнэ — дараа нь файлыг устгасан ч арилахгүй. Тэр үед
# нууц үг, түлхүүр бүрийг шинээр солихоос өөр арга байхгүй болно.
.env
.env.*
!.env.example

# ── Лог ба тестийн хамрах хүрээ ───────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# ── Түлхүүр, гэрчилгээ ────────────────────────────────────────────────
*.pem
*.key

# ── Vercel ────────────────────────────────────────────────────────────
.vercel

# ── Үйлдлийн систем ба засварлагч ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
