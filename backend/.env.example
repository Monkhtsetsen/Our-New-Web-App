# backend/.env — энэ файлыг .env нэрээр хуулж утгуудыг бөглөнө.
# .env нь git-д ОРОХГҮЙ (.gitignore). Энэ жишээ файлд нууц утга бичихгүй.

# PostgreSQL-ийн холболтын мөр.
# Локал (docker compose):
DATABASE_URL="postgresql://goal:goal_local_dev@localhost:5432/goal_app"
# Supabase:
# DATABASE_URL="postgresql://postgres:[НУУЦ-ҮГ]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Backend сонсох порт. Frontend 3000 дээр байдаг тул 4000.
PORT=4000

# Хөтчөөс хандахыг зөвшөөрөх frontend-ийн хаягууд (таслалаар тусгаарлана).
CORS_ORIGINS="http://localhost:3000"
