+/**
+ * Одоо байгаа зорилгыг хэсэгчлэн шинэчлэхэд хэрэглэнэ.
+ *
+ * Илгээгээгүй талбарыг хадгалах, илгээсэн талбарыг цэгцэлж ӨС рүү
+ * дамжуулах өөрчлөлтүүдийг л буцаана.
+ */
+export function validateGoalUpdate(
+  input: Record<string, unknown>,
+  today: string = todayInAppZone(),
+): { errors: GoalUpdateErrors; changes: GoalChanges } {
+  const errors: GoalUpdateErrors = {};
+  const changes: GoalChanges = {};
+
+  if (input.title !== undefined) {
+    const title = typeof input.title === "string" ? input.title.trim() : "";
+    if (title.length === 0) {
+      errors.title = "Зорилгынхоо нэрийг оруулна уу";
+    } else if (title.length > GOAL_TITLE_MAX_LENGTH) {
+      errors.title = `Нэр ${GOAL_TITLE_MAX_LENGTH} тэмдэгтээс урт байж болохгүй`;
+    } else {
+      changes.title = title;
+    }
+  }
+
+  if (input.description !== undefined) {
+    if (input.description === null) {
+      changes.description = null;
+    } else if (typeof input.description !== "string") {
+      errors.description = "Тайлбар буруу байна";
+    } else {
+      const description = input.description.trim();
+      if (description.length > GOAL_DESCRIPTION_MAX_LENGTH) {
+        errors.description =
+          `Тайлбар ${GOAL_DESCRIPTION_MAX_LENGTH} тэмдэгтээс урт байж болохгүй`;
+      } else {
+        changes.description = description.length === 0 ? null : description;
+      }
+    }
+  }
+
+  if (input.deadline !== undefined) {
+    if (input.deadline === null) {
+      changes.deadline = null;
+    } else {
+      const { error, deadline } = validateDeadline(input.deadline, today);
+      if (error !== undefined) {
+        errors.deadline = error;
+      } else if (deadline === null && typeof input.deadline === "string") {
+        const trimmed = input.deadline.trim();
+        if (trimmed.length === 0) changes.deadline = null;
+      } else if (deadline !== null) {
+        changes.deadline = deadline;
+      }
+    }
+  }
+
+  if (input.category !== undefined) {
+    if (input.category === null) {
+      errors.category = "Ангилал буруу байна";
+    } else {
+      const { error, category } = validateCategory(input.category);
+      if (error !== undefined) {
+        errors.category = error;
+      } else {
+        changes.category = category;
+      }
+    }
+  }
+
+  if (input.status !== undefined) {
+    if (typeof input.status !== "string" || !isGoalStatus(input.status)) {
+      errors.status =
+        `Төлөв нь ${GOAL_STATUSES.join(", ")}-ийн аль нэг байх ёстой`;
+    } else {
+      changes.status = input.status;
+    }
+  }
+
+  return { errors, changes };
+}
+
+export function validateGoalChanges(
+  input: Record<string, unknown>,
+  today: string = todayInAppZone(),
+): { errors: GoalUpdateErrors; changes: GoalChanges } {
+  return validateGoalUpdate(input, today);
+}
+
+export function isGoalStatus(value: string): value is GoalStatus {
+  return (GOAL_STATUSES as readonly string[]).includes(value);
+}
