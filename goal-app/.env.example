# goal-app/.env.local — энэ файлыг .env.local нэрээр хуулна.
# .env.local нь git-д ОРОХГҮЙ.

# Backend API-ийн хаяг.
#
# NEXT_PUBLIC_ угтвар нь утгыг хөтөч рүү дамжуулна — энэ нь зориуд, учир
# нь хүсэлтүүд хэрэглэгчийн хөтчөөс шууд явдаг. Иймд энд НУУЦ утга
# бичиж болохгүй: API түлхүүр, ӨС-ийн нууц үг бүгд backend талд байна.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Next.js-ийн СЕРВЕР талаас backend руу хандах хаяг.
#
# Дээрхээс ЯЛГААТАЙ: энэ хүсэлт хөтчөөс биш, Next.js-ийн процессоос
# явна. Docker дээр тэр процесс өөр контейнер дотор байдаг тул
# "localhost" гэж хандвал өөрийгөө хайна — сүлжээн дэх нэрээр нь
# дуудна. Локал дээр хоёулаа ижил тул бичихгүй ч болно.
#
# NEXT_PUBLIC_ угтваргүй тул энэ утга хөтөч рүү дамжихгүй.
# BACKEND_INTERNAL_URL="http://backend:4000"
