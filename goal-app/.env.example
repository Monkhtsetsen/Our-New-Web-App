# goal-app/.env.local — энэ файлыг .env.local нэрээр хуулна.
# .env.local нь git-д ОРОХГҮЙ.

# Backend API-ийн хаяг.
#
# NEXT_PUBLIC_ угтвар нь утгыг хөтөч рүү дамжуулна — энэ нь зориуд, учир
# нь хүсэлтүүд хэрэглэгчийн хөтчөөс шууд явдаг. Иймд энд НУУЦ утга
# бичиж болохгүй: API түлхүүр, ӨС-ийн нууц үг бүгд backend талд байна.
NEXT_PUBLIC_API_URL="http://localhost:4000"
