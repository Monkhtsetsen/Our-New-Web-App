# Энэ файлыг .env.local нэрээр хуулж аваад, утгуудыг нь өөрийн
# Supabase төслийн мэдээллээр солино. .env.local-г git-д оруулахгүй.
#
#   cp .env.example .env.local

# Өгөгдлийн сангийн холболт (шууд 5432 порт).
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase клиентийн тохиргоо.
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google Gemini API түлхүүр (AI Coach, зорилго задлах функцэд).
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
